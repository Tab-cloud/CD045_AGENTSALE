# Local rehearsal only. The run script enables this and binds to 127.0.0.1.
AGENTSALE_LOCAL_DEMO=1
# Optional absolute path on NTFS on Windows; never use a shared DB directory.
# Default: %LOCALAPPDATA%/AgentSale/<workspace-name-and-hash>/pglite
# Set AGENTSALE_DATA_DIR in your shell before running pnpm dev/start to override.
NEXT_TELEMETRY_DISABLED=1
# Optional isolated local port (default 3045).
# AGENTSALE_PORT=3046
# Optional administrator portal port (default: operator port + 2).
# AGENTSALE_ADMIN_PORT=3048
# Optional absolute executables if FFmpeg is not on PATH.
# AGENTSALE_FFMPEG=C:\tools\ffmpeg.exe
# AGENTSALE_FFPROBE=C:\tools\ffprobe.exe
# Configure model/search credentials only in the administrator page.
# Production member/API origin: LINGFENG_PUBLIC_URL=https://lingfeng.zailink.space
# Production administrator origin: LINGFENG_ADMIN_URL=https://admin.lingfeng.zailink.space
# Set these on the server only; do not enable public mode in local rehearsal.
