{
  "name": "lingfeng-web",
  "description": "聆风 AI Web 服务",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {"node": ">=24 <25"},
  "scripts": {
    "dev": "node scripts/run-portals.mjs dev",
    "start": "node scripts/run-portals.mjs start",
    "build": "node scripts/run-portals.mjs build",
    "dev:operator": "node scripts/run-console.mjs dev",
    "start:operator": "node scripts/run-console.mjs start",
    "typecheck": "pnpm --filter @agentsale/console typecheck && pnpm --filter @agentsale/admin-console typecheck",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
