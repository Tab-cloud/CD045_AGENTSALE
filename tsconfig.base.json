{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@agentsale/automation": ["apps/web/packages/automation/src/index.ts"],
      "@agentsale/contracts": [
        "apps/web/packages/contracts/src/index.ts"
      ],
      "@agentsale/domain": [
        "apps/web/packages/domain/src/index.ts"
      ],
      "@agentsale/database": [
        "apps/web/packages/database/src/index.ts"
      ],
      "@agentsale/ui/*": [
        "packages/ui/src/*"
      ]
    }
  }
}
